# =====================================================
# 部署目标配置模板（bash 语法，由 deploy/deploy.sh 读取）
# 使用方法：复制本文件为 deploy/deploy.env 并按实际填写。
# deploy.env 已被 .gitignore 忽略，不会被提交。
# =====================================================

# 服务器 SSH 登录目标：用户@主机（云主机常见 ubuntu@公网IP 或 root@公网IP）
DEPLOY_HOST=ubuntu@192.0.2.10

# SSH 端口（默认 22，改过端口的填实际端口）
DEPLOY_SSH_PORT=22

# 站点域名（不带 https:// 前缀）：用于 nginx server_name、证书申请与 BLOG_SITE_URL
DEPLOY_DOMAIN=blog.example.com

# 站点对外访问地址（可选，默认 https://$DEPLOY_DOMAIN）。
# 「域名尚未备案 / 暂无域名」先用 IP 访问时：DEPLOY_DOMAIN 填服务器 IP，
# 并加一行 DEPLOY_SITE_URL=http://IP（RSS/sitemap/robots 里的链接用它拼）。
# 备案通过切回域名后：DEPLOY_DOMAIN 改回域名、删除本行，重跑 init（幂等）再跑 cert。
# DEPLOY_SITE_URL=http://192.0.2.10
