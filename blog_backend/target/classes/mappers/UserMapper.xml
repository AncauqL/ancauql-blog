    <!-- 3. 更新 -->
    <update id="update"
            parameterType="com.example.blog_backend.entity.User">
        update user
        set user_name = #{userName}, age = #{age}, sex = #{sex}, phone
                      = #{phone}, address = #{address}, password = #{password}
        where id = #{id}
    </update>

