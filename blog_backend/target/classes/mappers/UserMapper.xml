<!--    </select>-->

    <!-- 5. 查询所有 -->
    <select id="selectAll"
            resultType="com.example.blog_backend.entity.User">
        select * from user
    </select>

    <!-- 6. 批量添加 -->
    <insert id="batchInsert" parameterType="java.util.List"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (user_name, age, sex, phone, address,
        password) VALUES
        <foreach collection="users" item="user" separator=",">
            (#{user.userName}, #{user.age}, #{user.sex}, #{user.phone},
            #{user.address}, #{user.password})
        </foreach>
    </insert>

</mapper>